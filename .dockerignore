# Secrets — provided via platform secrets / env, never baked into the image
.env

# Local DB (a fresh one is created on the mounted volume)
*.db
*.db-shm
*.db-wal

# Python / venv / caches
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Dev junk
.git/
.DS_Store
*.md
report.md
futurePlan.md

# NOTE: credentials.json is NOT ignored — it's the Google OAuth client and
# is needed at runtime. If you prefer not to bake it in, remove it here,
# delete it from the build, and inject it as a secret (see setup/DEPLOY.md).
