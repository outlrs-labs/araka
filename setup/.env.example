# ════════════════════════════════════════════════════════════════
# FollowUp Bot — environment template
# Copy to the PROJECT ROOT as `.env` and fill in the real values.
#   cp setup/.env.example .env
# Generate the secret values with:  python setup/generate_secrets.py
# ════════════════════════════════════════════════════════════════

# ── WhatsApp Business Cloud API (Meta) ──────────────────────────
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_long_lived_access_token
WA_VERIFY_TOKEN=generate_a_random_32_byte_token
WA_API_VERSION=v21.0

# App Secret enables webhook signature verification. STRONGLY recommended.
WA_APP_SECRET=your_meta_app_secret
# Fail closed: reject any webhook whose signature doesn't match.
REQUIRE_WA_SIGNATURE=true

# Approved utility template used to notify / remind assignees.
WA_MEETING_TEMPLATE_NAME=gmeet_confirmation
WA_MEETING_TEMPLATE_LANGUAGE=en_US

# Approved utility template (one body variable) used to deliver a reminder when
# the user has been quiet >24h (free-form is blocked outside the 24h window).
# Empty = no fallback. See Document/REMINDER_TEMPLATE_SETUP.md.
WA_REMINDER_TEMPLATE_NAME=
WA_REMINDER_TEMPLATE_LANGUAGE=en_US

# ── Flask server ────────────────────────────────────────────────
FLASK_PORT=5000
FLASK_SECRET=generate_a_random_secret

# ── Groq (LLM, OpenAI-compatible) ───────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Google OAuth2 ───────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials.json
# Fernet key — REQUIRED so Google tokens are encrypted at rest.
# Without it, tokens are stored in plaintext. Generate one with the helper.
GOOGLE_TOKEN_ENCRYPTION_KEY=your_fernet_key

# ── Database (SQLite is fine up to ~100 users) ──────────────────
DATABASE_URL=sqlite+aiosqlite:///notebot.db
SQLITE_BUSY_TIMEOUT_MS=30000
WEBHOOK_DEDUPE_TTL_HOURS=24

# ── Bot ─────────────────────────────────────────────────────────
BOT_TIMEZONE=Asia/Kolkata

# Operator phone (wa_id: country code, no +). If set, the reminder heartbeat
# pings this number when reminders are stuck undelivered. Leave blank to disable.
ADMIN_WA_ID=

# ── Public URL — OPTIONAL ───────────────────────────────────────
# No user-facing flow needs this anymore: Google sign-in uses the
# localhost paste flow (no domain) and the privacy notice is a hosted
# Google Doc. The WhatsApp webhook still needs a public HTTPS URL, but
# that's configured in the Meta dashboard, not here. Leave blank unless
# you later enable the domain-based OAuth auto-callback.
BASE_URL=

# Published WhatsApp Flow for the meeting form (empty = text prompts).
# See Document/WHATSAPP_FLOWS_SETUP.md.
WA_GMEET_FLOW_ID=

# Published WhatsApp Flow for sending email from chat (empty = feature off).
# The user types To/Subject/Body in the form; the AI never sees the content.
# See Document/EMAIL_FLOW_SETUP.md.
WA_EMAIL_FLOW_ID=

# ── Sarvam AI (chat brain, OpenAI-compatible) ──────────────────
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v1
